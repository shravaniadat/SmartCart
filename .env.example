# Copy to .env (same folder as app.py) and edit. Real environment variables override this file.

# Manager password for /admin and /inventory (required unless --demo; demo default is demo1234)
ADMIN_PASSWORD=change-me

# Real UPI payment request in the checkout QR. Leave empty for a DEMO-ONLY QR.
MERCHANT_UPI_ID=
MERCHANT_NAME=SmartMart Group 21

# Database file (default: smartmart.db next to app.py)
#SMARTMART_DB=/home/pi/SmartCart/smartmart.db

# Web server
PORT=5000
#HOST=0.0.0.0
# flask (default) or waitress (pip install waitress)
#SMARTMART_SERVER=waitress

# Load cell: hx711 (GPIO), serial (Arduino over USB) or none
SCALE_DRIVER=hx711
HX711_DT_PIN=5
HX711_SCK_PIN=6
#SCALE_SERIAL_PORT=/dev/ttyUSB0
#SCALE_SERIAL_BAUD=57600
# Minimum allowed difference in grams (load-cell noise) and settle time in seconds
#WEIGHT_MIN_TOLERANCE_G=30
#WEIGHT_SETTLE_S=2

# I2C LCD address in hex; leave unset to auto-detect 0x27 / 0x3F
#LCD_ADDRESS=27

# Optional fixed session secret (otherwise generated into .session_secret)
#SECRET_KEY=
